{
  "name": "@local/budget-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pauses a turn for confirmation once the session spent more tokens than configured since its last check.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
